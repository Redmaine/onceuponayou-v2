# Add these in Netlify → Site settings → Environment variables.
# Never commit real values — this file lists names only.

ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
REPLICATE_API_TOKEN=
RESEND_API_KEY=
BOOKVAULT_API_KEY=
# Admin-dashboard gate. Use the value from the build brief. Set it in Netlify
# only — never commit the real value to git.
INTERNAL_SECRET=

# Frontend build-time vars (Vite exposes only VITE_-prefixed vars to the client).
# The site URL is used to build Stripe success/return links.
VITE_SITE_URL=https://onceuponayou.co.uk
